# Public/browser-visible (safe to expose; leave blank for labelled local mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only secret — never prefix this with NEXT_PUBLIC_ and never commit it
CLERK_SECRET_KEY=
ATLAS_SESSION_SECRET=replace_with_a_long_random_secret

# Canonical URL(s) accepted by Clerk middleware; comma-separated for a separately hosted frontend
ATLAS_PUBLIC_ORIGIN=http://localhost:3000

# Clerk redirects. Clerk reads these itself; the app also uses them as defaults,
# so keep them aligned with your routes. FALLBACK keeps any Clerk-provided
# redirect_url (e.g. a deep link to /money) — do not set the FORCE variants.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/inbox
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/inbox

# Google OAuth, encryption keys, AI keys and storage live on the Convex deployment, not here:
#   npx convex env set GOOGLE_CLIENT_ID ...   (also GOOGLE_CLIENT_SECRET, ENCRYPTION_KEY,
#   GROQ_API_KEYS, AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, ATLAS_ALLOW_PAID_AI,
#   ATLAS_MAX_DAILY_SPEND_USD, ATLAS_SITE_ORIGINS). Google redirect URIs to register:
#   <origin>/api/oauth/gmail/callback and <origin>/api/oauth/google_tasks/callback

# Optional local-only override; do not use for production
# ATLAS_LOCAL_STORE_DIR=.atlas-local-store

# --- Convex (Atlas v2) ---------------------------------------------------------
# Written by `npx convex dev` into .env.local:
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# Set ON THE CONVEX DEPLOYMENT with `npx convex env set NAME value`, not here:
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL; also create a Clerk JWT template named "convex"
#   CLERK_WEBHOOK_SECRET      Clerk webhook (user.deleted) -> <convex site url>/clerk-users-webhook
#   GROQ_API_KEYS             comma-separated; keys from one Groq org share one quota
#   GEMINI_API_KEYS           free tier is used for public_text only
#   GEMINI_PAID=false         true only if the Gemini project has billing enabled
#   AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY   Bedrock (IAM limited to bedrock:InvokeModel)
#   ATLAS_ALLOW_PAID_AI=false
#   ATLAS_MAX_DAILY_SPEND_USD=0   paid AI stays off until this is above 0
#   ATLAS_AI_CHAIN_<CAPABILITY>   optional override, e.g. ATLAS_AI_CHAIN_TEXT=groq,bedrock
