# Public/browser-visible (safe to expose; use production pk_live_ in production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only secrets — never prefix these with NEXT_PUBLIC_ and never commit values
CLERK_SECRET_KEY=sk_test_replace_me
ATLAS_SESSION_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgresql://user:password@host:5432/atlas?sslmode=require
ENCRYPTION_KEY=replace_with_a_long_random_encryption_key
ENCRYPTION_KEY_PREVIOUS=

# Canonical URL(s) accepted by Clerk middleware; comma-separated for a separately hosted frontend
ATLAS_PUBLIC_ORIGIN=http://localhost:3000

# Clerk redirects. Clerk reads these itself; the app also uses them as defaults,
# so keep them aligned with your routes. FALLBACK keeps any Clerk-provided
# redirect_url (e.g. a deep link to /money) — do not set the FORCE variants.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/inbox
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/inbox

# Private wardrobe asset provider (required for real image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional read-only Gmail connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Optional Google Tasks connector (shared Google OAuth client)
GOOGLE_REFRESH_TOKEN=
ATLAS_ENABLE_GOOGLE_TASKS=false
GOOGLE_TASKS_REDIRECT_URI=http://localhost:3000/api/google-tasks/callback
# Tax deadlines can be represented by a dedicated Google Tasks list named
# "Atlas Tax"; Atlas reads tasks only and never completes or edits them.

# Optional local-only override; do not use for production
# ATLAS_LOCAL_STORE_DIR=.atlas-local-store
